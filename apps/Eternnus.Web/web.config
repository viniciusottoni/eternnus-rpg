<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Planos de conta (ADR-102): o IIS recusa por padrão corpos acima de ~28,6 MB antes de chegarem ao app.
           Teto = maior requisição aceita pelo app: 100 MiB de arquivo (plano Max) + 2 MiB da composição de mapa/cena.
           O limite real continua por rota no Kestrel (UploadLimits; demais rotas: 64 KiB) e por plano no endpoint.
           O SDK acrescenta aspNetCore/handlers na publicação; preserve-remote-env.ps1 mantém as variáveis do painel. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="106954752" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
